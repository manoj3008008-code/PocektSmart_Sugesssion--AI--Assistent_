APP_NAME=PocketSmart AI
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./pocketsmart.db

# Add your Google Gemini API key to enable real AI.
GEMINI_API_KEY=your_google_api_key_here
# Current Gemini Flash model; can be changed without changing application code.
GEMINI_MODEL=gemini-3.8-flash
# true = local deterministic fallback; false = use Gemini when API key is present
USE_MOCK_AI=true

ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
MAX_IMAGE_MB=5